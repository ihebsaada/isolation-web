{"help": "https://www.donneesquebec.ca/recherche/api/3/action/help_show?name=package_show", "success": true, "result": {"author": "Secteur de l'infrastructure fonci\u00e8re et de l'information g\u00e9ospatiale - Direction g\u00e9n\u00e9rale de l\u2019information g\u00e9ospatiale", "author_email": "geoboutique@mrnf.gouv.qc.ca", "creator_user_id": "6dae464f-b8e9-4024-b26a-e58c62617945", "doi": "", "ext_spatial": "province-quebec", "extras_donnees_reference": [], "extras_flag_donnees_normalise": "", "extras_metadata_modified": "", "extras_organisation_principale": "gouvernement-du-quebec", "id": "eec20550-7916-4ff9-b9bf-9e07288b4a17", "inv_access_level": "open", "inv_data_hosting": "", "inv_data_location": "quebec_canada", "inv_esd": [], "inv_key_data": [], "inv_official_source": [], "inv_reason_not_open": "", "inv_security_classification": "Public", "inventory_metadata": [], "isopen": true, "language": "FR", "license_id": "cc-by", "license_title": "Attribution (CC-BY 4.0)", "license_url": "https://www.donneesquebec.ca/licence/#cc-by", "maintainer": null, "maintainer_email": null, "metadata_created": "2018-05-24T15:44:04.126000", "metadata_modified": "2026-09-24T17:47:35.937531", "methodologie": "La mise \u00e0 jour des donn\u00e9es est effectu\u00e9e de fa\u00e7on mensuelle, lorsqu'il y a des modifications.", "name": "decoupages-administratifs", "notes": "Les couches de d\u00e9coupages administratifs offertes aux \u00e9chelles de 1/20 000 et 1/100 000 permettent la localisation des limites pour les composantes suivantes :\r\n\r\n*   Les arrondissements et agglom\u00e9rations;\r\n*   Les municipalit\u00e9s, territoires non organis\u00e9s et territoires autochtones;\r\n*   Les r\u00e9gions administratives, communaut\u00e9s m\u00e9tropolitaines, et MRC;\r\n*   La fronti\u00e8re internationale, les fronti\u00e8res interprovinciales ainsi que la fronti\u00e8re Qu\u00e9bec\u2013Terre-Neuve-et-Labrador.\r\n\r\nPour la version \u00e0 l\u2019\u00e9chelle de 1/100 000, les donn\u00e9es sur les d\u00e9coupages compil\u00e9es initialement \u00e0 l\u2019\u00e9chelle de 1/20 000 sont ajust\u00e9es aux composantes planim\u00e9triques correspondantes \u00e0 l'\u00e9chelle de 1/100 000.\r\n\r\nUn fichier sur les renvois municipaux est \u00e9galement disponible dans la section donn\u00e9es ci-dessous. Il permet d\u2019effectuer le suivi des modifications apport\u00e9es aux noms des municipalit\u00e9s.  ", "num_resources": 12, "num_tags": 8, "organization": {"id": "95c1ba5b-25ec-405d-8647-3a975d4ac992", "name": "mrn", "title": "Minist\u00e8re des Ressources naturelles et des For\u00eats", "type": "organization", "description": "Le minist\u00e8re des Ressources naturelles et des For\u00eats a pour mission d'assurer la gestion et de soutenir la mise en valeur des ressources \u00e9nerg\u00e9tiques et min\u00e9rales ainsi que du territoire du Qu\u00e9bec, dans une perspective de d\u00e9veloppement durable.", "image_url": "2023-01-27-185706.622052MRNFw3couleur.png", "created": "2015-10-26T12:05:04.834920", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "95c1ba5b-25ec-405d-8647-3a975d4ac992", "private": false, "spatial_data": "Oui", "state": "active", "temporal": "", "title": "D\u00e9coupages administratifs", "type": "dataset", "update_frequency": "monthly", "url": "https://mrnf.gouv.qc.ca/ministere/cartes-information-geographique/", "version": null, "groups": [{"description": "Administration publique, gouvernance, \u00e9lection, contrat, budget, rapport financier, subvention, relations internationales", "display_name": "Gouvernement et finances", "id": "4223c6b5-f54b-471c-813d-19d6d1cc5f2f", "image_display_url": "https://www.donneesquebec.ca/recherche/images/categories/gouvernement-finances.svg", "name": "gouvernement-finances", "title": "Gouvernement et finances"}], "resources": [{"cache_last_updated": null, "cache_url": null, "created": "2018-05-24T11:47:29.943174", "datastore_active": false, "datastore_conta